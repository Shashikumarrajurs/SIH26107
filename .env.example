# ============================================================
# NexaStandards — Environment Configuration
# Smart India Hackathon 2026 · Problem Statement SIH26107
# Policy: Evidence-Grounded • Source-Locked • Update-Aware
# ============================================================

# ── Project Metadata ─────────────────────────────────────────
PROJECT_NAME="NexaStandards"
SIH_YEAR="2026"
PROBLEM_STATEMENT="SIH26107"
VERSION="2.0.0"
STATUTORY_POLICY="Evidence-Grounded • Source-Locked • Update-Aware"

# ── Database ─────────────────────────────────────────────────
# Local SQLite (authoritative for demo & automated testing):
DATABASE_URL="sqlite:///./bis_smartassist.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexa_standards"

# ── Regulatory Validation & Grounding Gating ─────────────────
CONFIDENCE_THRESHOLD=0.75

# ── Vector Search & Embeddings ───────────────────────────────
QDRANT_URL="http://localhost:6333"
EMBEDDING_MODEL="bge-m3"

# ── Optional External LLM Integration ────────────────────────
# NexaStandards uses a deterministic Docling layout-aware generator by default.
# If Gemini or Ollama keys are supplied, they will be used with strict grounding constraints.
GEMINI_API_KEY=""
OLLAMA_URL="http://localhost:11434"
LLM_MODEL="qwen2.5:7b"

# ── Security & JWT ───────────────────────────────────────────
JWT_SECRET="nexa_standards_sih2026_statutory_secret_key_change_in_prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_CALLS=60
RATE_LIMIT_WINDOW=60

# ── Polling & Source Sync ────────────────────────────────────
SYNC_POLL_INTERVAL_MINUTES=60

# ── Frontend API Proxy URL ───────────────────────────────────
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
